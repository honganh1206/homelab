[client]
default-character-set = utf8mb4

[server]
# Skip hostnames, use only IPs for connections
skip_name_resolve = ON
# Values considered for low usage scenario
max_connections = 50
thread_cache_size = 50
character_set_server = utf8mb4
collation_server = utf8mb4_general_ci
tmp_table_size = 64M

# InnoDB storage engine parameters

# 80% of memory available for MariaDB server (recommended)
innodb_buffer_pool_size = 256M
innodb_io_capacity = 2000
innodb_io_capacity_max = 3000
# The bigger the buffer, the larger transaction MariaDB can execute without hitting storage wall
innodb_log_buffer_size = 32M
innodb_log_file_size = 256M
